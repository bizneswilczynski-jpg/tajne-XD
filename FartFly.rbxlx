<roblox version="4">
  <Item class="Lighting" referent="0">
    <Properties>
      <string name="Name">Lighting</string>
      <Color3 name="Ambient">
        <R>0.35</R>
        <G>0.35</G>
        <B>0.4</B>
      </Color3>
